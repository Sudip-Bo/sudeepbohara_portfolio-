# Required in production.
# PostgreSQL connection string used by Prisma (see prisma/schema.prisma).
# Backs every database-driven surface: /projects and /projects/[slug], Featured Work,
# Services, the /admin console, and contact message persistence.
# Without it the site still builds and renders, but those surfaces are empty.
DATABASE_URL="postgresql://user:password@localhost:5432/sudeepbohara_db?schema=public"

# Optional.
# Resend API key used by /api/contact to email a notification for new enquiries.
# If unset, submissions are still saved to the Message table and the email is skipped.
RESEND_API_KEY="re_123456789_example_key"
